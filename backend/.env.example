# MongoDB connection string (MongoDB Atlas recommended)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-travel-planner?retryWrites=true&w=majority

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps / Places API key — https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenWeatherMap API key — https://openweathermap.org/api
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server port
PORT=5000
