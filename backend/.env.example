# MongoDB connection string (MongoDB Atlas recommended)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# Groq API key — https://console.groq.com (free, fast LLaMA models)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps / Places API key — https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenWeatherMap API key — https://openweathermap.org/api
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server port
PORT=5000
